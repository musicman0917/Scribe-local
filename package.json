{
  "name": "scribe-local",
  "version": "1.0.0",
  "description": "A self-hosted, open-source alternative to Scribehow for building step-by-step software tutorials with automatic screen capture, click annotation, local Ollama-powered descriptions, redaction, and Markdown/HTML/PDF export.",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./public/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/input.css -o ./public/css/tailwind.css --watch"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "axios": "^1.7.9",
    "express": "^4.21.2",
    "pdfkit": "^0.15.1",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "uiohook-napi": "^1.5.4",
    "screenshot-desktop": "^1.15.1",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "nodemon": "^3.1.9",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17"
  }
}
